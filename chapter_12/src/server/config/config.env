#############################################################
#   System configuration settings.
#############################################################

SERVER_CONFIG="config/server_config.json"
LOG_DIR="logs"
WORKSPACE_DIR="workspace"

# RabbitMQ Config (local Ubuntu setup)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/  
RABBITMQ_QUEUE_FASTAPI_TO_ORCH=fastapi_to_orch
RABBITMQ_QUEUE_ORCH_TO_FASTAPI=orch_to_fastapi

RABBITMQ_QUEUE_BLENDER_TO_ORCH=blender_to_orch
RABBITMQ_QUEUE_TEST_SUBSCRIBER=test_subscriber

# PostgreSQL Config (local Ubuntu setup)
POSTGRE_USER=robot
POSTGRE_PASSWORD=1234567890

# MioIO File Sytem Config (local Ubuntu setup)
MINIO_URL = "localhost:9000"      # e.g., "192.168.1.100:9000" or "localhost:9000"
MINIO_USER = "robot"              # e.g., the Ubuntu user
MINIO_PASSWORD = "Robot@123"      # e.g., the Ubuntu user's password. 
