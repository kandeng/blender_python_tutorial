{
  "name": "openclaw-worker-node",
  "version": "1.0.0",
  "description": "SDK for creating OpenClaw worker nodes that execute tools",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --target node18 --out-dir dist",
    "dev": "tsup src/index.ts --format esm --watch --out-dir dist"
  },
  "keywords": ["openclaw", "worker", "node", "sdk", "agent", "ai"],
  "author": "OpenClaw",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
